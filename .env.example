# Copy to .env. Everything below runs locally with no paid accounts.
# The values here are development placeholders, not production secrets.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchpad
BETTER_AUTH_SECRET=dev-only-change-me-launchpad-secret-32b
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth. Buttons stay disabled until both id and secret are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Stripe test-mode keys. When STRIPE_SECRET_KEY is empty, checkout
# uses the in-app stub at /app/billing/checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional Resend. When RESEND_API_KEY is empty, mail is stored in the dev outbox.
RESEND_API_KEY=
EMAIL_FROM="LaunchPad <hello@launchpad.dev>"

# Set to true to expose /dev/emails outside development. Leave unset on a public deploy.
EMAIL_PREVIEW=
